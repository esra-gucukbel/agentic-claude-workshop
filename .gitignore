# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
!.idea/.gitignore
.vscode/
*.iml
*.iws
*.ipr
nbproject/
.project
.classpath
.settings/

# ── Node / npm (frontend & e2e) ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/

# ── Vite / frontend build ─────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── Playwright (e2e) ──────────────────────────────────────────────────────────
e2e/test-results/
e2e/playwright-report/
e2e/.playwright/

# ── Gradle / backend build ────────────────────────────────────────────────────
.gradle/
backend/.gradle/
backend/build/
backend/out/

# Keep the Gradle wrapper binaries
!backend/gradle/wrapper/gradle-wrapper.jar

# ── Secrets & environment ─────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
